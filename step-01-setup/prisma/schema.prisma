// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Placeholder model for Prisma client generation
// Full Todo model will be added in step-03-rds-sync
model Placeholder {
  id String @id
  @@map("_placeholder")
}
